+
+void HexagonGame::maybeEmitFingerprint()
+{
+    if(fingerprintFile == nullptr)
+    {
+        return; // OFF by default: no path, no behaviour change.
+    }
+
+    FingerprintBuilder b;
+
+    // S1/S2: the standard walls, in vector (spawn) order. The four
+    // vertices carry position AND orientation (no derived trig).
+    b.u32(static_cast<std::uint32_t>(walls.size()));
+
+    for(const CWall& w : walls)
+    {
+        for(const sf::Vector2f& p : w.getVertexPositions())
+        {
+            b.f32(p.x);
+            b.f32(p.y);
+        }
+
+        const SpeedData& s = w.getSpeed();
+        b.f32(s._speed);
+        b.f32(s._accel);
+        b.f32(s._min);
+        b.f32(s._max);
+        b.f32(s._pingPong);
+
+        const SpeedData& c = w.getCurve();
+        b.f32(c._speed);
+        b.f32(c._accel);
+        b.f32(c._min);
+        b.f32(c._max);
+        b.f32(c._pingPong);
+
+        b.f32(w.getHueMod());
+        b.u8(w.isDead() ? 1u : 0u);
+    }
+
+    // S3/S4: the custom walls, in ascending ALIVE-handle order (a
+    // destroyed handle is never read through the getters).
+    const std::vector<CCustomWallHandle> alive = cwManager.aliveHandles();
+    b.u32(static_cast<std::uint32_t>(alive.size()));
+
+    for(const CCustomWallHandle h : alive)
+    {
+        for(const sf::Vector2f& p : cwManager.getVertexPos4(h))
+        {
+            b.f32(p.x);
+            b.f32(p.y);
+        }
+
+        b.u8(cwManager.getKillingSide(h));
+
+        std::uint8_t flags{0};
+        if(!cwManager.getCanCollide(h))
+        {
+            flags |= 1u; // bit 0 = NoCollision (CWFlags / port bitfield)
+        }
+
+        if(cwManager.getDeadly(h))
+        {
+            flags |= 2u; // bit 1 = Deadly
+        }
+
+        b.u8(flags);
+    }
+
+    // S5: the player (position + rotation angle).
+    const sf::Vector2f pPos = player.getPosition();
+    b.f32(pPos.x);
+    b.f32(pPos.y);
+    b.f32(player.getPlayerAngle());
+
+    // S6: the status scalars.
+    b.f32(status.pulse);
+    b.f32(status.pulseDirection);
+    b.f32(status.pulseDelay);
+    b.f32(status.beatPulse);
+    b.f32(status.beatPulseDelay);
+    b.f32(status.pulse3D);
+    b.f32(status.pulse3DDirection);
+    b.f32(status.flashEffect);
+    b.f32(status.radius);
+    b.f32(status.fastSpin);
+    b.f32(status.cameraShake);
+
+    // S7: the status booleans.
+    b.u8(status.hasDied ? 1u : 0u);
+    b.u8(static_cast<std::uint8_t>(status.mustStateChange));
+    b.u8(status.scoreInvalid ? 1u : 0u);
+    b.u8(status.started ? 1u : 0u);
+    b.u8(status.showPlayerTrail ? 1u : 0u);
+
+    // S8/S9/S10: the custom score + the timekeeping (the `Final time`
+    // print is exactly field 9, at the final frame).
+    b.f32(status.getCustomScore());
+    b.f64(status.getTimeSeconds());
+    b.f64(status.getIncrementTimeSeconds());
+
+    // S11: the level-status timers.
+    b.u64(levelStatus.currentIncrements);
+    b.u32(static_cast<std::uint32_t>(levelStatus.sides));
+    b.f32(levelStatus.speedMult);
+    b.f32(levelStatus.delayMult);
+    b.f32(levelStatus.rotationSpeed);
+
+    // S12/S13: the difficulty and the replay's recorded score.
+    b.f32(difficultyMult);
+    b.f64(lastPlayedScore);
+
+    // S14: the entity counts (the particles are mostly cosmetic; counts
+    // are the comparable part — see the definition note).
+    b.u32(static_cast<std::uint32_t>(particles.size()));
+    b.u32(static_cast<std::uint32_t>(trailParticles.size()));
+    b.u32(static_cast<std::uint32_t>(swapParticles.size()));
+
+    // S15: the game-RNG canonical state label (see the definition note's
+    // "The canonical RNG-state label").
+    b.u64(rng.state());
+
+    const std::uint64_t drawsNow = rng.draws();
+    const std::uint64_t drawsDelta = drawsNow - fingerprintLastDraws;
+
+    char line[64];
+    std::snprintf(line, sizeof(line), "%lld %016llx %llu\n",
+        static_cast<long long>(fingerprintFrame),
+        static_cast<unsigned long long>(b.hash),
+        static_cast<unsigned long long>(drawsDelta));
+
+    std::fputs(line, fingerprintFile);
+
+    ++fingerprintFrame;
+    fingerprintLastDraws = drawsNow;
